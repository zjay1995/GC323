# Generated by tools\build.bat from config\<model>.h and VERSION.
# Committing either of these puts a model's settings back into the source
# tree, which is what the config\ directory exists to stop.
src/MODELCFG.H
src/VERSION.H
src/BUILD.STAMP

# Build output.
build/
*.obj
*.OBJ
*.exe
*.EXE
!src/WINSTUB.EXE
*.res
*.RES
*.sym
*.SYM
*.map
*.MAP
*.MAK
*.err
*.ERR

# Borland IDE state.
*.dsk
*.DSK
*.gid
*.GID
.idea/

# Editor and OS leftovers.
*~
*.swp
Thumbs.db
.DS_Store

# Old versions do not live in the working tree. A change worth keeping is
# a commit; a release worth keeping is a tag. See docs/ARCHIVE.md.
*.bak
*.BAK
*.orig
*.rej
*.old
*.OLD
*.CPPorig
*.CPP.ok
*.CPP.bbl
